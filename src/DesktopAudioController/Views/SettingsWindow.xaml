<Window x:Class="DesktopAudioController.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopAudioController.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{loc:Loc '설정'}"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        Width="750"
        Height="720"
        MinHeight="420"
        FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="16">
        <!-- 하단 버튼 영역에는 로그 폴더 바로가기와 저장/취소를 함께 둡니다. -->
        <Grid DockPanel.Dock="Bottom"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Padding="10,2" Grid.Column="0"
                    MinWidth="120"
                    HorizontalAlignment="Left"
                    Click="OpenLogFolderButton_OnClick"
                    Content="{loc:Loc '로그 폴더 열기'}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Padding="10,2" MinWidth="88"
                        Margin="0,0,8,0"
                        Click="CancelButton_OnClick"
                        Content="{loc:Loc '취소'}" />
                <Button Padding="10,2" MinWidth="88"
                        Click="SaveButton_OnClick"
                        Content="{loc:Loc '저장'}" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 화면 언어입니다. 이름은 어느 언어로 보고 있어도 찾을 수 있게 두 언어로 적습니다. -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="언어 / Language" />
                    <ComboBox Grid.Column="1"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding UiLanguage}" />
                    <TextBlock Grid.Column="2"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#666"
                               Text="{loc:Loc '저장하면 바로 바뀝니다.'}"
                               TextWrapping="Wrap" />
                </Grid>

                <!-- 최초 실행 또는 설정 변경 시 표시할 장치를 선택하는 영역입니다. -->
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="{loc:Loc '표시할 출력 장치 선택'}" />
                <TextBlock Margin="0,8,0,16"
                           Foreground="#666"
                           Text="{loc:Loc '여기서 고른 장치만 메인 화면에 표시됩니다. 장치 목록은 실제 Windows Core Audio 기준으로 조회됩니다.'}"
                           TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding AvailableDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 장치별 체크 카드입니다. -->
                            <Border Margin="0,0,0,8"
                                    Padding="10"
                                    CornerRadius="6"
                                    BorderBrush="#DDD"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected}">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </CheckBox>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="#666"
                                               Text="{loc:LocFormat Path=IsConnected, Format='연결됨: {0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 장치 선택 아래에는 메인 화면 표시 방식 옵션을 둡니다. -->
                <Separator Margin="0,16,0,16" />

                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding ShowOnlyConnectedDevices}">
                    <TextBlock Text="{loc:Loc '연결된 장치만 표시'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '연결이 끊긴 장치나 오프라인 가상 장치는 메인 화면에서 숨깁니다.'}"
                           TextWrapping="Wrap" />
                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding ShowSystemSounds}">
                    <TextBlock Text="{loc:Loc '시스템 사운드 세션도 표시'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc 'Windows 알림음과 시스템 소리도 프로그램 목록에 함께 표시합니다.'}"
                           TextWrapping="Wrap" />
                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding ShowOnlyActiveSessions}">
                    <TextBlock Text="{loc:Loc '재생 중인 앱만 보기'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '체크하지 않으면 현재 조용한 앱도 목록에 유지하고, 상태 문구로만 구분합니다.'}"
                           TextWrapping="Wrap" />

                <Separator Margin="0,8,0,16" />

                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="{loc:Loc '수동 프로필'}" />
                <TextBlock Margin="0,8,0,16"
                           Foreground="#666"
                           Text="{loc:Loc '현재 장치 표시 설정과 프로그램별 볼륨, 음소거, 이름 저장값을 묶어 저장합니다. 프로필을 고르면 기본 출력·입력(마이크) 장치, 대체 장치, 앱별 출력 장치, 장치 볼륨, 단축키를 더 지정할 수 있습니다.'}"
                           TextWrapping="Wrap" />

                <WrapPanel Margin="0,0,0,8">
                    <ComboBox Width="220"
                              Margin="0,0,8,8"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding AudioProfiles}"
                              SelectedItem="{Binding SelectedAudioProfile}" />
                    <Button Padding="10,2" MinWidth="132"
                            Margin="0,0,8,8"
                            Click="CreateAudioProfileButton_OnClick"
                            Content="{loc:Loc '프로필 만들기'}" />
                    <Button Padding="10,2" MinWidth="132"
                            Margin="0,0,8,8"
                            Click="ApplyAudioProfileButton_OnClick"
                            Content="{loc:Loc '프로필 적용'}"
                            IsEnabled="{Binding HasSelectedAudioProfile}" />
                    <Button Padding="10,2" MinWidth="132"
                            Margin="0,0,8,8"
                            Click="DeleteAudioProfileButton_OnClick"
                            Content="{loc:Loc '프로필 삭제'}"
                            IsEnabled="{Binding HasSelectedAudioProfile}" />
                </WrapPanel>

                <!-- 선택한 프로필을 적용할 때 함께 바꿀 기본 장치·앱별 출력·단축키를 편집합니다. -->
                <Border Margin="0,0,0,8"
                        Padding="12"
                        CornerRadius="6"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Visibility="{Binding HasSelectedAudioProfile, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{loc:LocFormat Path=SelectedAudioProfile.Name, Format='{}{0} 프로필을 적용할 때'}" />


                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{loc:Loc '기본 출력 장치'}" />
                            <ComboBox Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding DefaultDeviceOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedProfileDefaultDeviceId}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{loc:Loc '  없으면 대신 1'}" />
                            <ComboBox Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding OutputFallbackOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedProfileOutputFallback1}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{loc:Loc '  없으면 대신 2'}" />
                            <ComboBox Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding OutputFallbackOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedProfileOutputFallback2}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{loc:Loc '기본 입력(마이크)'}" />
                            <ComboBox Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding InputDeviceOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedProfileDefaultInputDeviceId}" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{loc:Loc '  없으면 대신'}" />
                            <ComboBox Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding InputFallbackOptions}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedProfileInputFallback1}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#666"
                                   Text="{loc:Loc '기본 출력·입력은 Windows 의 \'기본 장치\'와 \'기본 통신 장치\'를 함께 바꿉니다(디스코드처럼 통신 장치를 쓰는 앱도 따라옴). 장치가 꺼져 있거나 빠져 있으면 \'없으면 대신\' 순서로 고르고 알림을 띄웁니다. 앱별 출력 대상이 없을 때도 출력 대체 순서를 씁니다.'}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,12,0,4"
                                   Text="{loc:Loc '앱별 출력 장치'}" />
                        <TextBlock Margin="0,0,0,8"
                                   Foreground="#666"
                                   Text="{loc:Loc '실행 파일 이름(작업 관리자 \'세부 정보\' 탭의 이름, 예: TslGame.exe, chrome.exe, Discord.exe)을 적고 보낼 장치를 고릅니다. 프로필을 적용하는 순간 실행 중인 프로그램에만 적용됩니다. 이미 소리를 내고 있는 일부 앱(게임·브라우저 등)은 다시 시작해야 바뀐 장치로 나옵니다. 앱별 지정이 없는 앱은 기본 출력 장치를 따릅니다.'}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SelectedProfileRoutes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox IsEditable="True"
                                                  IsTextSearchEnabled="False"
                                                  ItemsSource="{Binding DataContext.RunningProcessNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   Text="→" />
                                        <ComboBox Grid.Column="2"
                                                  DisplayMemberPath="Name"
                                                  ItemsSource="{Binding DataContext.RouteDeviceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding TargetDeviceId}" />
                                        <Button Padding="10,2" Grid.Column="3"
                                                MinWidth="56"
                                                Margin="8,0,0,0"
                                                Click="RemoveProfileRouteButton_OnClick"
                                                Content="{loc:Loc '삭제'}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Padding="10,2" MinWidth="132"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Left"
                                Click="AddProfileRouteButton_OnClick"
                                Content="{loc:Loc '앱별 출력 추가'}" />

                        <TextBlock Margin="0,14,0,4"
                                   Text="{loc:Loc '장치 볼륨·음소거'}" />
                        <TextBlock Margin="0,0,0,8"
                                   Foreground="#666"
                                   Text="{loc:Loc '프로필을 적용할 때 장치 볼륨과 음소거를 함께 맞춥니다. 예: 이어폰 20%로 시작(귀 보호), 이어폰 프로필에서 스피커 음소거. 볼륨 칸을 비우면 볼륨은 그대로 둡니다.'}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SelectedProfileDeviceLevels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox DisplayMemberPath="Name"
                                                  ItemsSource="{Binding DataContext.LevelDeviceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding DeviceId}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Text="{loc:Loc '볼륨'}" />
                                        <TextBox Grid.Column="2"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding VolumeText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{loc:Loc '0~100, 비우면 그대로'}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="4,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Text="%" />
                                        <ComboBox Grid.Column="4"
                                                  DisplayMemberPath="Name"
                                                  ItemsSource="{Binding DataContext.MuteOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Mode"
                                                  SelectedValue="{Binding MuteMode}" />
                                        <Button Padding="10,2" Grid.Column="5"
                                                MinWidth="56"
                                                Margin="8,0,0,0"
                                                Click="RemoveProfileDeviceLevelButton_OnClick"
                                                Content="{loc:Loc '삭제'}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Padding="10,2" MinWidth="132"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Left"
                                Click="AddProfileDeviceLevelButton_OnClick"
                                Content="{loc:Loc '장치 볼륨 추가'}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{loc:Loc '단축키'}" />
                            <TextBox Grid.Column="1"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedProfileHotkey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#666"
                                       Text="{loc:Loc '예: Ctrl+Alt+1 (비우면 없음)'}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#666"
                                   Text="{loc:Loc '여기서 바꾼 값은 아래 \'저장\'을 눌러야 프로필에 저장됩니다.'}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Separator Margin="0,8,0,16" />

                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="{loc:Loc '프로필 전환'}" />
                <TextBlock Margin="0,8,0,16"
                           Foreground="#666"
                           Text="{loc:Loc '프로필은 메인 화면 버튼, 트레이 메뉴, 단축키, 명령(스트림덱 등)으로 바꿉니다.'}"
                           TextWrapping="Wrap" />
                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding EnableProfileHotkeys}">
                    <TextBlock Text="{loc:Loc '프로필 단축키 사용'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '단축키는 위의 프로필 편집 영역에서 프로필마다 지정합니다. 다른 프로그램이 이미 쓰는 조합이면 저장할 때 안내합니다.'}"
                           TextWrapping="Wrap" />
                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding ShowAutoProfileNotifications}">
                    <TextBlock Text="{loc:Loc '단축키·명령으로 바뀔 때 알림 표시'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '장치가 없어 대체 장치를 썼거나 적용에 실패한 경우에는 이 설정과 상관없이 알림을 띄웁니다.'}"
                           TextWrapping="Wrap" />

                <!-- 실행 프로그램 기준 자동 전환은 사용자 결정으로 쓰지 않아 화면에서 숨깁니다(기본 꺼짐). -->
                <StackPanel Visibility="Collapsed">
                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding AutoProfileSwitchEnabled}">
                    <TextBlock Text="{loc:Loc '실행 중인 프로그램에 맞춰 프로필 자동 전환'}" />
                </CheckBox>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="{loc:Loc '기본 프로필'}" />
                    <ComboBox Grid.Column="1"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding FallbackProfileOptions}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding AutoProfileFallbackProfileId}" />
                    <TextBlock Grid.Column="2"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#666"
                               Text="{loc:Loc '\'기본 프로필로\'를 고른 규칙이 끝나면 적용합니다.'}"
                               TextWrapping="Wrap" />
                </Grid>

                <TextBlock Margin="0,0,0,8"
                           Foreground="#666"
                           Text="{loc:Loc '여러 규칙의 프로그램이 함께 실행 중이면 위에 있는 규칙이 우선합니다. 프로그램 이름은 쉼표로 여러 개 적을 수 있습니다.'}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,0,0,8"
                           Foreground="#999"
                           Text="{loc:Loc '아직 규칙이 없습니다.'}"
                           Visibility="{Binding HasNoAutoProfileRules, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl ItemsSource="{Binding AutoProfileRules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="10"
                                    CornerRadius="6"
                                    BorderBrush="#DDD"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox Grid.Row="0"
                                              Grid.Column="0"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled}"
                                              ToolTip="{loc:Loc '규칙 사용'}" />
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{loc:LocFormat Path=Priority, Format='우선순위 {0}'}" />
                                    <TextBox Grid.Row="0"
                                             Grid.Column="2"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:Loc '규칙 이름 (알림에 표시, 비워도 됨)'}" />
                                    <StackPanel Grid.Row="0"
                                                Grid.Column="3"
                                                Margin="8,0,0,0"
                                                Orientation="Horizontal">
                                        <Button Width="32"
                                                Margin="0,0,4,0"
                                                Click="MoveAutoProfileRuleUpButton_OnClick"
                                                Content="▲"
                                                ToolTip="{loc:Loc '우선순위 올리기'}" />
                                        <Button Width="32"
                                                Margin="0,0,4,0"
                                                Click="MoveAutoProfileRuleDownButton_OnClick"
                                                Content="▼"
                                                ToolTip="{loc:Loc '우선순위 내리기'}" />
                                        <Button Padding="10,2" MinWidth="56"
                                                Click="RemoveAutoProfileRuleButton_OnClick"
                                                Content="{loc:Loc '삭제'}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,8,0,0"
                                               VerticalAlignment="Center"
                                               Text="{loc:Loc '실행되면'}" />
                                    <ComboBox Grid.Row="1"
                                              Grid.Column="2"
                                              Grid.ColumnSpan="2"
                                              Margin="0,8,0,0"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              ItemsSource="{Binding DataContext.RunningProcessNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding ProcessNamesText, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{loc:Loc '예: TslGame.exe, SC2_x64.exe'}" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="0,8,0,0"
                                               VerticalAlignment="Center"
                                               Text="{loc:Loc '적용할 프로필'}" />
                                    <StackPanel Grid.Row="2"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="2"
                                                Margin="0,8,0,0"
                                                Orientation="Horizontal">
                                        <ComboBox Width="200"
                                                  DisplayMemberPath="Name"
                                                  ItemsSource="{Binding DataContext.AudioProfiles, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding ProfileId}" />
                                        <TextBlock Margin="12,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Text="{loc:Loc '꺼지면'}" />
                                        <ComboBox Width="130"
                                                  DisplayMemberPath="Name"
                                                  ItemsSource="{Binding DataContext.RestoreModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Mode"
                                                  SelectedValue="{Binding RestoreMode}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Padding="10,2" MinWidth="132"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        Click="AddAutoProfileRuleButton_OnClick"
                        Content="{loc:Loc '규칙 추가'}"
                        IsEnabled="{Binding HasAudioProfiles}" />
                </StackPanel>

                <Separator Margin="0,8,0,16" />

                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="{loc:Loc '업데이트 확인'}" />
                <TextBlock Margin="0,8,0,16"
                           Foreground="#666"
                           Text="{loc:Loc '기본값은 정식(stable) 릴리즈만 확인합니다. 필요하면 프리릴리즈도 함께 안내할 수 있습니다.'}"
                           TextWrapping="Wrap" />

                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding IncludePreReleaseUpdates}">
                    <TextBlock Text="{loc:Loc '프리릴리즈 업데이트도 함께 확인'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '체크하면 테스트용 미리보기 버전까지 새 버전 안내에 포함합니다.'}"
                           TextWrapping="Wrap" />

                <Separator Margin="0,8,0,16" />

                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="{loc:Loc '진단 로그'}" />
                <TextBlock Margin="0,8,0,16"
                           Foreground="#666"
                           Text="{loc:Loc '문제 분석이 필요할 때만 상세 로그를 켭니다. 일반 사용 중에는 끄면 세션 조회 같은 반복 로그가 줄어듭니다.'}"
                           TextWrapping="Wrap" />

                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding EnableDebugLogs}">
                    <TextBlock Text="{loc:Loc '디버그 로그 기록'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '켜면 장치 열거, 세션 조회, 새로고침 단계 같은 DEBUG 로그를 함께 기록합니다.'}"
                           TextWrapping="Wrap" />
                <WrapPanel Margin="24,0,0,12">
                    <Button Padding="10,2" MinWidth="168"
                            Margin="0,0,8,8"
                            Click="ExportDiagnosticPackageButton_OnClick"
                            Content="{loc:Loc '진단 패키지 내보내기'}" />
                    <Button Padding="10,2" MinWidth="208"
                            Margin="0,0,8,8"
                            Click="ExportDiagnosticIssueDraftButton_OnClick"
                            Content="{loc:Loc '진단 패키지 및 이슈 작성'}" />
                </WrapPanel>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#B35A00"
                           Text="{loc:Loc '저장하면 처음부터 디버그 로그를 기록하기 위해 앱이 자동으로 재시작됩니다.'}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsDebugLogRestartWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Separator Margin="0,8,0,16" />

                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="{loc:Loc '설정 관리'}" />
                <TextBlock Margin="0,8,0,16"
                           Foreground="#666"
                           Text="{loc:Loc '현재 설정을 파일로 내보내거나, 이전에 내보낸 설정으로 복구할 수 있습니다.'}"
                           TextWrapping="Wrap" />

                <WrapPanel Margin="0,0,0,8">
                    <Button Padding="10,2" MinWidth="132"
                            Margin="0,0,8,8"
                            Click="ExportSettingsButton_OnClick"
                            Content="{loc:Loc '설정 내보내기'}" />
                    <Button Padding="10,2" MinWidth="132"
                            Margin="0,0,8,8"
                            Click="ImportSettingsButton_OnClick"
                            Content="{loc:Loc '설정 가져오기'}" />
                    <Button Padding="10,2" MinWidth="132"
                            Margin="0,0,8,8"
                            Click="ResetSettingsButton_OnClick"
                            Content="{loc:Loc '설정 초기화'}" />
                    <Button Padding="10,2" MinWidth="168"
                            Margin="0,0,8,8"
                            Click="ClearProgramSettingsButton_OnClick"
                            Content="{loc:Loc '프로그램 저장값 초기화'}" />
                </WrapPanel>
                <TextBlock Margin="0,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '가져오기, 초기화, 프로그램 저장값 초기화는 즉시 저장되고 메인 화면을 다시 불러옵니다.'}"
                           TextWrapping="Wrap" />

                <Separator Margin="0,8,0,16" />

                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="{loc:Loc '실행 동작'}" />
                <TextBlock Margin="0,8,0,16"
                           Foreground="#666"
                           Text="{loc:Loc '창을 닫을 때의 동작과 자동 실행 방식을 정합니다.'}"
                           TextWrapping="Wrap" />

                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding MinimizeToTray}">
                    <TextBlock Text="{loc:Loc '닫기 버튼을 누르면 트레이로 최소화'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '완전히 종료하려면 트레이 메뉴의 종료를 사용합니다.'}"
                           TextWrapping="Wrap" />
                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding RunAtWindowsStartup}">
                    <TextBlock Text="{loc:Loc 'Windows 로그인 후 자동 실행'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '현재 사용자 계정에만 적용되며, 앱은 백그라운드에서 자동으로 시작됩니다.'}"
                           TextWrapping="Wrap" />
                <CheckBox Margin="0,0,0,8"
                          IsChecked="{Binding StartMinimized}"
                          IsEnabled="{Binding RunAtWindowsStartup}">
                    <TextBlock Text="{loc:Loc '자동 실행 시 시작하자마자 최소화'}" />
                </CheckBox>
                <TextBlock Margin="24,-4,0,12"
                           Foreground="#666"
                           Text="{loc:Loc '자동 실행이 켜져 있을 때만 적용됩니다.'}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
